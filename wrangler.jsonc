{
  // Standalone Ciyan: deploy independently from the AppLauncher Worker.
  // Keep the existing Ciyan hostname so iOS local study data remains accessible.
  "name": "ciyan",
  "compatibility_date": "2026-11-19",
  "workers_dev": true,
  "main": "./worker.js",
  "services": [{ "binding": "PROFILES", "service": "pwa-profiles-api" }, { "binding": "COMMON", "service": "pwa-core-api" }],
  "assets": { "directory": "./dist/standalone", "binding": "ASSETS" }
}
